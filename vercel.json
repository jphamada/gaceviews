{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/discursos-papa",
      "destination": "/discursos-papa/dist/index.html"
    },
    {
      "source": "/discursos-papa/",
      "destination": "/discursos-papa/dist/index.html"
    },
    {
      "source": "/discursos-papa/:path*",
      "destination": "/discursos-papa/dist/:path*"
    }
  ]
}
